# Project Metta Environment Variables Template

# Fast Path: TypeSafe Jev System 1 (Precept validation, knot classification)
TYPESAFE_API_KEY=apikey_your_typesafe_key_here

# Core AI Providers: gemini, gemini-rest, openai, claude, mock
METTA_DEFAULT_PROVIDER=gemini
METTA_DEFAULT_MODEL=gemini-3.8-flash-high

# Optional BYOM Gemini REST key (can also be entered dynamically in Web UI settings)
GEMINI_API_KEY=

# Supabase Cloud Storage (Personal Memory Graphs)
# Automatically falls back to local SQLite (metta_memory.db) if omitted
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
